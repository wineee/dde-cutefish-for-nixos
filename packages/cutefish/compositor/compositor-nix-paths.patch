+// Where the session's own companions live: they come from cutefish-core, which
+// itself starts this compositor, so their store paths cannot be compiled in.
+// The session puts them on PATH; the security delegate compares canonical
+// paths, hence the resolution.
+static std::vector<std::string> companionExecutables(std::initializer_list<std::string> names)
+{
+    std::vector<std::string> executables;
+    for (const std::string &name : names) {
+        const std::string candidate = base::paths::findExecutable(name);
+        if (candidate.empty())
+            continue;
+        std::error_code error;
+        executables.push_back(std::filesystem::canonical(candidate, error).string());
+    }
+    return executables;
+}
