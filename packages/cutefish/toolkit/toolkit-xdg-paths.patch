+// The XDG data directories. NixOS has no /usr/share, so the search path has
+// to come from the environment; the spec default is the fallback.
+static std::vector<std::string> dataDirectories()
+{
+    const char* value = getenv("XDG_DATA_DIRS");
+    const std::string text = value && *value ? value : "/usr/local/share:/usr/share";
+
+    std::vector<std::string> directories;
+    for (size_t start = 0; start <= text.size();) {
+        const size_t end = text.find(':', start);
+        std::string part = text.substr(start, end == std::string::npos ? std::string::npos : end - start);
+        if (!part.empty() && part.front() == '/') {
+            if (part.size() > 1 && part.back() == '/')
+                part.pop_back();
+            directories.push_back(part);
+        }
+        if (end == std::string::npos)
+            break;
+        start = end + 1;
+    }
+    return directories;
+}
