+// A colon separated search path from the XDG base directory spec. Relative
+// entries are ignored, as the spec requires. NixOS has no /usr/share, so the
+// environment has to win over the spec defaults.
+static std::vector<std::string> searchPath(const char* variable, std::vector<std::string> fallback)
+{
+    const char* value = getenv(variable);
+    const std::string text = value && *value ? value : "";
+
+    std::vector<std::string> directories;
+    for (size_t start = 0; start <= text.size();) {
+        const size_t end = text.find(':', start);
+        std::string part = text.substr(start, end == std::string::npos ? std::string::npos : end - start);
+        if (!part.empty() && part.front() == '/') {
+            if (part.size() > 1 && part.back() == '/')
+                part.pop_back();
+            directories.push_back(part);
+        }
+        if (end == std::string::npos)
+            break;
+        start = end + 1;
+    }
+    return directories.empty() ? fallback : directories;
+}
